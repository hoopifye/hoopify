# Database
# Replace with your actual PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/hoopify?schema=public"

# App URL (used for better-auth)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth Secret (generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BETTER_AUTH_SECRET="your-secret-key-here-replace-with-random-string"

