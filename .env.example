# ===========================================
# HOOPIFYE ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in your values
# For Vercel deployment, add these in the Vercel dashboard

# ===========================================
# DATABASE (Required)
# ===========================================
# For local development:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/hoopify?schema=public"
#
# For Vercel/Production - use one of these:
# - Vercel Postgres: Get from Vercel Storage dashboard
# - Neon: postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# - Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
# - PlanetScale: (requires different adapter)
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# Direct URL for migrations (required for connection pooling services like Neon/Supabase)
# Use the non-pooled/direct connection string here
DIRECT_URL="postgresql://user:password@host:5432/database?schema=public"

# ===========================================
# APP URL (Required)
# ===========================================
# Local development:
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
#
# Production (your domain):
NEXT_PUBLIC_APP_URL="https://hoopifye.pl"

# Better Auth URL (should match NEXT_PUBLIC_APP_URL)
BETTER_AUTH_URL="https://hoopifye.pl"

# ===========================================
# AUTHENTICATION (Required)
# ===========================================
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="your-secret-key-here-replace-with-random-string"

# ===========================================
# EMAIL (Required for email verification)
# ===========================================
# Get your API key from https://resend.com
RESEND_API_KEY="re_xxxxxxxxx"
EMAIL_SENDER_NAME="Hoopifye"
EMAIL_SENDER_ADDRESS="noreply@hoopifye.pl"

# ===========================================
# SOCIAL PROVIDERS (Optional)
# ===========================================
# Google OAuth - https://console.cloud.google.com/
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# GitHub OAuth - https://github.com/settings/developers
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
